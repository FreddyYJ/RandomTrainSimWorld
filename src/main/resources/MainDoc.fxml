<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Layout:
      [Route | Locomotive | Livery | Journey | Scenario]   <- horizontal SplitPane, dividers draggable
      Route, Locomotive and Scenario panes each contain a vertical SplitPane:
        [checkbox list]
        [description]                           <- divider draggable
      Each pane: picked result + "Pick ..." button. "Pick All" at the bottom.
-->
<?import javafx.scene.control.CheckBox?>
<AnchorPane fx:id="anchorPane" minHeight="400.0" minWidth="700.0" prefHeight="600.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.github.freddyyj.randomtrainsimworld.gui.MainController">
   <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
         AnchorPane.topAnchor="0.0">
      <MenuBar>
         <Menu mnemonicParsing="false" text="File">
            <MenuItem fx:id="itemSave" mnemonicParsing="false" onAction="#onSave" text="Save" accelerator="Shortcut+S"/>
            <MenuItem fx:id="itemSaveAs" mnemonicParsing="false" onAction="#onSaveAs" text="Save As..."/>
            <MenuItem fx:id="itemLoad" mnemonicParsing="false" onAction="#onLoad" text="Load..."/>
         </Menu>
         <Menu mnemonicParsing="false" text="Help">
            <MenuItem fx:id="itemAbout" mnemonicParsing="false" onAction="#onHelp" text="About"/>
         </Menu>
      </MenuBar>

      <SplitPane fx:id="splitMain" dividerPositions="0.2, 0.4, 0.6, 0.8" VBox.vgrow="ALWAYS">
         <!-- Route pane -->
         <VBox minWidth="120.0" spacing="5.0">
            <padding><Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/></padding>
            <Label style="-fx-font-weight: bold;" text="Route"/>
            <ComboBox fx:id="comboNation" maxWidth="Infinity"/>
            <SplitPane fx:id="splitRoute" dividerPositions="0.65" orientation="VERTICAL" VBox.vgrow="ALWAYS">
               <ScrollPane fitToWidth="true" minHeight="50.0">
                  <VBox fx:id="boxRoute">
                     <!-- Dummy route element, remove later -->
                     <CheckBox fx:id="dummyRouteCheckBox" text="Dummy Route"/>
                  </VBox>
               </ScrollPane>
               <TextArea fx:id="textRouteDescription" editable="false" minHeight="40.0"
                         promptText="Route description" wrapText="true"/>
            </SplitPane>
            <TextField fx:id="textPickedRoute" editable="false"/>
            <Button fx:id="buttonRandomRoute" maxWidth="Infinity" mnemonicParsing="false"
                    onAction="#onRandomRoute" text="Pick Route"/>
         </VBox>

         <!-- Locomotive pane: content (VBox of checkboxes) is set per route by the controller -->
         <VBox minWidth="120.0" spacing="5.0">
            <padding><Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/></padding>
            <Label style="-fx-font-weight: bold;" text="Locomotive"/>
            <SplitPane fx:id="splitLoco" dividerPositions="0.65" orientation="VERTICAL" VBox.vgrow="ALWAYS">
               <ScrollPane fx:id="boxLoco" fitToWidth="true" minHeight="50.0"/>
               <TextArea fx:id="textLocoDescription" editable="false" minHeight="40.0"
                         promptText="Locomotive description" wrapText="true"/>
            </SplitPane>
            <TextField fx:id="textPickedLoco" editable="false"/>
            <Button fx:id="buttonRandomLoco" maxWidth="Infinity" mnemonicParsing="false"
                    onAction="#onRandomLoco" text="Pick Locomotive"/>
         </VBox>

         <!-- Livery pane: content is set per locomotive by the controller -->
         <VBox minWidth="120.0" spacing="5.0">
            <padding><Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/></padding>
            <Label style="-fx-font-weight: bold;" text="Livery"/>
            <ScrollPane fx:id="boxLivery" fitToWidth="true" VBox.vgrow="ALWAYS"/>
            <TextField fx:id="textPickedLivery" editable="false"/>
            <Button fx:id="buttonRandomLivery" maxWidth="Infinity" mnemonicParsing="false"
                    onAction="#onRandomLivery" text="Pick Livery"/>
         </VBox>

         <!-- Journey pane: content is set per route by the controller -->
         <VBox minWidth="120.0" spacing="5.0">
            <padding><Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/></padding>
            <Label style="-fx-font-weight: bold;" text="Journey"/>
            <ScrollPane fx:id="boxJourney" fitToWidth="true" VBox.vgrow="ALWAYS"/>
            <TextField fx:id="textPickedJourney" editable="false"/>
            <Button fx:id="buttonRandomJourney" maxWidth="Infinity" mnemonicParsing="false"
                    onAction="#onRandomJourney" text="Pick Journey"/>
            <Button fx:id="buttonRandomJourneyAll" maxWidth="Infinity" mnemonicParsing="false"
                    onAction="#onRandomJourneyAll" text="Pick Journey (All Routes)"/>
         </VBox>

         <!-- Scenario pane: content (VBox of checkboxes) is set per route by the controller -->
         <VBox minWidth="120.0" spacing="5.0">
            <padding><Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/></padding>
            <Label style="-fx-font-weight: bold;" text="Scenario"/>
            <SplitPane fx:id="splitScenario" dividerPositions="0.65" orientation="VERTICAL" VBox.vgrow="ALWAYS">
               <ScrollPane fx:id="boxScenario" fitToWidth="true" minHeight="50.0"/>
               <TextArea fx:id="textScenarioDescription" editable="false" minHeight="40.0"
                         promptText="Scenario description" wrapText="true"/>
            </SplitPane>
            <TextField fx:id="textPickedScenario" editable="false"/>
            <Button fx:id="buttonRandomScenario" maxWidth="Infinity" mnemonicParsing="false"
                    onAction="#onRandomScenario" text="Pick Scenario"/>
            <Button fx:id="buttonRandomScenarioAll" maxWidth="Infinity" mnemonicParsing="false"
                    onAction="#onRandomScenarioAll" text="Pick Scenario (All Routes)"/>
         </VBox>
      </SplitPane>

      <HBox alignment="CENTER">
         <padding><Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/></padding>
         <Button fx:id="buttonRandomAll" defaultButton="true" mnemonicParsing="false"
                 onAction="#onRandomAll" prefWidth="150.0" text="Pick All"/>
      </HBox>
   </VBox>
</AnchorPane>
